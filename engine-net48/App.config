<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- Design-time user code runs in this process (the compiled fallback, a base form's constructor, a control's
         Load). A Thread / ThreadPool / System.Threading.Timer callback it starts that later throws would, under the
         default policy, terminate the whole engine and fail every open designer. The legacy policy lets the process
         survive; the exception is still reported through AppDomain.UnhandledException (logged by the render worker). -->
    <legacyUnhandledExceptionPolicy enabled="1" />
  </runtime>
</configuration>
